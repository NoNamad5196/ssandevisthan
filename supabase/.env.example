# Server-only secrets. Never copy service-role/OpenAI/internal secrets to VITE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_WORKER_SECRET=
CORS_ORIGINS=https://REPLACE_WITH_ACTUAL_DEPLOYED_HOST
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Remain false until account/model/price/budget history and Edge benchmarks pass.
PAID_EXECUTION_ENABLED=false
NORMALIZER_VERIFIED=false
EGRESS_VERIFIED=false
BROWSER_RUN_ENABLED=false
# Bundled WASM local path, not a user-provided URL.
MAGICK_WASM_PATH=./magick.wasm
